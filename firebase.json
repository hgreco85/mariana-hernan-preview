{
  "hosting": {
    "target": "wedding",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "CNAME",
      "**/.*",
      "**/node_modules/**",
      "tests/**",
      "worker/**",
      "scripts/**",
      "*.md",
      ".claspignore",
      ".clasprc.json",
      "appsscript.json",
      "Code.js",
      "before.html",
      "photo-audit.html"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=600"
          }
        ]
      }
    ]
  }
}
